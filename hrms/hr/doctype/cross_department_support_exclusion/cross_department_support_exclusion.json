{
 "doctype": "DocType",
 "name": "Cross Department Support Exclusion",
 "module": "HR",
 "autoname": "CDSE-.YYYY.-.#####",
 "engine": "InnoDB",
 "track_changes": 1,
 "field_order": [
  "employee",
  "employee_name",
  "from_date",
  "to_date",
  "reason",
  "is_active"
 ],
 "fields": [
  {
   "fieldname": "employee",
   "fieldtype": "Link",
   "options": "Employee",
   "label": "员工",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "employee_name",
   "fieldtype": "Data",
   "fetch_from": "employee.employee_name",
   "read_only": 1,
   "label": "姓名"
  },
  {
   "fieldname": "from_date",
   "fieldtype": "Date",
   "label": "排除开始日期",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "to_date",
   "fieldtype": "Date",
   "label": "排除结束日期",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "reason",
   "fieldtype": "Small Text",
   "label": "排除原因",
   "reqd": 1
  },
  {
   "fieldname": "is_active",
   "fieldtype": "Check",
   "label": "生效",
   "default": "1",
   "in_list_view": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1
  },
  {
   "role": "HR Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1
  },
  {
   "role": "HR User",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1
  }
 ]
}
