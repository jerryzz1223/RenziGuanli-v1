{
 "doctype": "DocType",
 "name": "Interview Registration",
 "module": "HR",
 "autoname": "IR-.YYYY.-.#####",
 "engine": "InnoDB",
 "track_changes": 1,
 "title_field": "candidate_name",
 "search_fields": "candidate_name,phone,interview_position",
 "sort_field": "interview_date",
 "sort_order": "DESC",
 "field_order": [
  "company",
  "registration_column",
  "registration_month",
  "basic_section",
  "candidate_name",
  "phone",
  "source",
  "native_place",
  "basic_column",
  "gender",
  "age",
  "education",
  "marital_status",
  "interview_section",
  "interview_date",
  "interview_position",
  "interview_column",
  "interviewer",
  "referrer",
  "result_section",
  "hired",
  "rejection_reason",
  "result_column",
  "assigned_department",
  "assigned_position",
  "arrival_section",
  "expected_start_date",
  "arrival_status",
  "arrival_column",
  "no_show_reason",
  "source_section",
  "source_sequence",
  "source_file",
  "source_row",
  "import_key",
  "source_month"
 ],
 "fields": [
  {
   "fieldname": "company",
   "label": "公司",
   "fieldtype": "Link",
   "options": "Company",
   "reqd": 1
  },
  {
   "fieldname": "registration_month",
   "label": "面试月份",
   "fieldtype": "Data",
   "read_only": 1,
   "in_list_view": 1,
   "description": "根据面试日期自动生成。"
  },
  {
   "fieldname": "basic_section",
   "label": "应聘人员",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "candidate_name",
   "label": "姓名",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "native_place",
   "label": "籍贯",
   "fieldtype": "Data"
  },
  {
   "fieldname": "source",
   "label": "招聘渠道",
   "fieldtype": "Data",
   "description": "例如：门口、网上、员工介绍。"
  },
  {
   "fieldname": "phone",
   "label": "联系电话",
   "fieldtype": "Data",
   "reqd": 1
  },
  {
   "fieldname": "basic_column",
   "label": "",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "gender",
   "label": "性别",
   "fieldtype": "Select",
   "options": "\n男\n女"
  },
  {
   "fieldname": "education",
   "label": "学历",
   "fieldtype": "Data"
  },
  {
   "fieldname": "marital_status",
   "label": "婚姻状况",
   "fieldtype": "Select",
   "options": "\n未婚\n已婚\n离异\n丧偶"
  },
  {
   "fieldname": "age",
   "label": "年龄",
   "fieldtype": "Int",
   "non_negative": 1
  },
  {
   "fieldname": "interview_section",
   "label": "面试信息",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "interview_date",
   "label": "面试日期",
   "fieldtype": "Date",
   "reqd": 1,
   "in_list_view": 1,
   "default": "Today"
  },
  {
   "fieldname": "interview_position",
   "label": "应聘岗位",
   "fieldtype": "Data",
   "reqd": 1,
   "description": "填写本次应聘的岗位名称。"
  },
  {
   "fieldname": "interview_column",
   "label": "",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "referrer",
   "label": "介绍人",
   "fieldtype": "Data"
  },
  {
   "fieldname": "interviewer",
   "label": "面试官",
   "fieldtype": "Data"
  },
  {
   "fieldname": "result_section",
   "label": "录用结果与岗位分配",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "hired",
   "label": "录用结果",
   "fieldtype": "Select",
   "options": "\n是\n否",
   "in_list_view": 1,
   "description": "是 = 已录用，否 = 未录用；结果未确定时留空。"
  },
  {
   "fieldname": "assigned_department",
   "label": "分配部门",
   "fieldtype": "Data"
  },
  {
   "fieldname": "assigned_position",
   "label": "分配岗位",
   "fieldtype": "Data"
  },
  {
   "fieldname": "rejection_reason",
   "label": "未录用原因 / 备注",
   "fieldtype": "Small Text",
   "description": "填写未录用原因或需要保留的补充说明。"
  },
  {
   "fieldname": "arrival_section",
   "label": "报到跟进",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "expected_start_date",
   "label": "预计到岗日期",
   "fieldtype": "Date"
  },
  {
   "fieldname": "arrival_status",
   "label": "报到状态",
   "fieldtype": "Select",
   "options": "\n待报到\n已报到\n未报到",
   "description": "仅按已确认的跟进情况填写；未确认时留空。"
  },
  {
   "fieldname": "no_show_reason",
   "label": "未报到原因",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "source_sequence",
   "label": "原表序号",
   "fieldtype": "Data",
   "read_only": 1
  },
  {
   "fieldname": "source_file",
   "label": "导入文件",
   "fieldtype": "Attach",
   "read_only": 1
  },
  {
   "fieldname": "source_row",
   "label": "原表行号",
   "fieldtype": "Int",
   "read_only": 1
  },
  {
   "fieldname": "import_key",
   "label": "导入标识",
   "fieldtype": "Data",
   "hidden": 1,
   "read_only": 1,
   "unique": 1,
   "no_copy": 1
  },
  {
   "fieldname": "source_month",
   "label": "原表月份",
   "fieldtype": "Data",
   "read_only": 1
  },
  {
   "fieldname": "registration_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "result_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "arrival_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "source_section",
   "fieldtype": "Section Break",
   "label": "导入来源",
   "collapsible": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1,
   "print": 1,
   "export": 1,
   "delete": 1
  },
  {
   "role": "HR Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1,
   "print": 1,
   "export": 1,
   "delete": 1
  },
  {
   "role": "HR User",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1,
   "print": 1,
   "export": 1
  }
 ]
}
